{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/colis/:id/:action",
      "destination": "/api/colis/:id?action=:action"
    },
    {
      "source": "/api/bordereaux/:id/:action",
      "destination": "/api/bordereaux/:id?action=:action"
    },
    {
      "source": "/api/caisse/:action",
      "destination": "/api/caisse?action=:action"
    },
    {
      "source": "/api/notifications/:action",
      "destination": "/api/notifications?action=:action"
    }
  ]
}
