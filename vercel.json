{
  "crons": [
    { "path": "/api/taches/quotidienne", "schedule": "0 5 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/colis/:id/:action",
      "destination": "/api/colis/:id?action=:action"
    },
    {
      "source": "/api/bordereaux/:id/:action",
      "destination": "/api/bordereaux/:id?action=:action"
    },
    {
      "source": "/api/caisse/:action",
      "destination": "/api/caisse?action=:action"
    },
    {
      "source": "/api/notifications/:action",
      "destination": "/api/notifications?action=:action"
    },
    {
      "source": "/api/facturation/:action",
      "destination": "/api/facturation?action=:action"
    },
    {
      "source": "/api/plateforme/:action",
      "destination": "/api/plateforme?action=:action"
    },
    {
      "source": "/api/taches/:action",
      "destination": "/api/taches?action=:action"
    },
    {
      "source": "/api/paiements/:action",
      "destination": "/api/paiements?action=:action"
    },
    {
      "source": "/api/suivi/:code/:action",
      "destination": "/api/suivi/:code?action=:action"
    }
  ]
}
