rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function destinationIdOf(data) {
      return 'destinationAgencyId' in data ? data.destinationAgencyId : null;
    }

    function agencyExists(agencyId) {
      return agencyId is string && agencyId != '' &&
        exists(/databases/$(database)/documents/agences/$(agencyId));
    }

    function isValidDeclaredAgency(agency) {
      return agency is map &&
        agency.name is string && size(agency.name) >= 2 && size(agency.name) <= 120 &&
        agency.city is string && size(agency.city) >= 2 && size(agency.city) <= 60 &&
        agency.phone is string && agency.phone.matches('^0[1-9][0-9]{8}$');
    }

    function canReadParcel(data) {
      return signedIn() && (
        data.ownerId == request.auth.uid ||
        (destinationIdOf(data) != null && destinationIdOf(data) == request.auth.uid)
      );
    }

    function isValidPublicTracking(data, code) {
      return data.keys().hasOnly([
        'code', 'colisId', 'status', 'history', 'originCity',
        'destinationCity', 'lastUpdatedAtISO'
      ]) &&
      data.code == code &&
      data.colisId is string &&
      data.status is string &&
      data.history is list &&
      data.originCity is string &&
      data.destinationCity is string &&
      data.lastUpdatedAtISO is string;
    }

    function trackingMatchesParcel(data, code) {
      let parcel = getAfter(/databases/$(database)/documents/colis/$(data.colisId));
      return data.colisId is string &&
        parcel.data.trackingCode == code &&
        parcel.data.status == data.status &&
        parcel.data.history == data.history &&
        parcel.data.originCity == data.originCity &&
        parcel.data.destinationCity == data.destinationCity &&
        (parcel.data.ownerId == request.auth.uid ||
          destinationIdOf(parcel.data) == request.auth.uid);
    }

    match /agences/{agencyId} {
      allow create: if signedIn() && request.auth.uid == agencyId;
      allow get, list: if signedIn();
      allow update: if signedIn() && request.auth.uid == agencyId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'city', 'phone']);
      allow delete: if false;
    }

    match /colis/{parcelId} {
      function isAttachmentUpdate(before, after) {
        return before.ownerId == request.auth.uid &&
          destinationIdOf(before) == null &&
          agencyExists(after.destinationAgencyId) &&
          after.destinationAgencyId != request.auth.uid &&
          after.destinationAgencyName is string &&
          after.destinationAgencyCity is string &&
          after.status == before.status &&
          after.ownerId == before.ownerId &&
          after.trackingCode == before.trackingCode &&
          after.unregisteredDestinationAgency == before.unregisteredDestinationAgency &&
          after.destinationCity is string &&
          size(after.destinationCity) >= 2 && size(after.destinationCity) <= 60 &&
          after.diff(before).affectedKeys().hasOnly([
            'destinationAgencyId', 'destinationAgencyName', 'destinationAgencyCity',
            'destinationAgencyAttachedAt', 'destinationAgencyAttachedBy',
            'destinationCity', 'history', 'updatedAt'
          ]);
      }

      function isProgressUpdate(before, after) {
        return after.diff(before).affectedKeys().hasOnly(['status', 'history', 'updatedAt', 'collectedBy']) &&
          after.ownerId == before.ownerId &&
          after.trackingCode == before.trackingCode &&
          destinationIdOf(after) == destinationIdOf(before);
      }

      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'trackingCode', 'ownerId', 'destinationAgencyId', 'destinationAgencyName',
          'destinationAgencyCity', 'originCity', 'destinationCity', 'status', 'history'
        ]) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.trackingCode is string &&
        request.resource.data.destinationAgencyName is string &&
        request.resource.data.destinationAgencyCity is string &&
        request.resource.data.status == 'Enregistré' &&
        request.resource.data.history is list && size(request.resource.data.history) >= 1 &&
        size(request.resource.data.originCity) >= 2 && size(request.resource.data.originCity) <= 60 &&
        size(request.resource.data.destinationCity) >= 2 && size(request.resource.data.destinationCity) <= 60 &&
        (
          (
            agencyExists(request.resource.data.destinationAgencyId) &&
            request.resource.data.destinationAgencyId != request.auth.uid &&
            !('unregisteredDestinationAgency' in request.resource.data)
          )
          ||
          (
            request.resource.data.destinationAgencyId == null &&
            isValidDeclaredAgency(request.resource.data.unregisteredDestinationAgency)
          )
        );

      allow get, list: if canReadParcel(resource.data);

      allow update: if canReadParcel(resource.data) &&
        (isProgressUpdate(resource.data, request.resource.data) ||
          isAttachmentUpdate(resource.data, request.resource.data));

      allow delete: if false;
    }

    match /suivis/{code} {
      allow read: if true;
      allow create: if signedIn() &&
        isValidPublicTracking(request.resource.data, code) &&
        trackingMatchesParcel(request.resource.data, code);
      allow update: if signedIn() &&
        resource.data.colisId == request.resource.data.colisId &&
        isValidPublicTracking(request.resource.data, code) &&
        trackingMatchesParcel(request.resource.data, code);
      allow delete: if false;
    }
  }
}
